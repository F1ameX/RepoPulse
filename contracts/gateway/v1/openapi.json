  "x-serialization": {
    "json": "HTTP DTO JSON: snake_case; required fields present including null and empty arrays",
    "int64": "not used; GitHub numeric IDs represented by strings",
    "timestamps": "RFC3339 UTC Z; exact stored precision for window; UI display seconds only"
  },
  "x-invariants": [
    "No client owner/session IDs in HTTP request bodies. additionalProperties=false.",
    "VerifiedContext contains at least one currently valid identity; new job picks account before guest; saved Owner exactly one.",
    "Every state-changing cookie request validates Origin/CSRF; no wildcard credentialed CORS.",
    "Replay owner/request_id checked before GitHub; changed canonical URL -> 409.",
    "HTTP 404 and gRPC NOT_FOUND do not disclose foreign resource metadata.",
    "Invalid/expired presented account cookie must not silently fall back to guest for a new operation; continue-as-guest is explicit."
  ],
