    "/api/v1/auth/guest-session": {
      "post": {
        "operationId": "createGuestSession",
        "summary": "Выдать guest session cookie; максимум 24 ч, без persistent Max-Age/Expires.",
        "responses": {
          "201": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "repopulse_guest: HttpOnly; Secure; SameSite=Lax; Path=/api/v1; без Max-Age/Expires; серверный срок 24 ч.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
