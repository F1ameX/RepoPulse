            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "repopulse_session: HttpOnly; Secure; SameSite=Lax; Path=/api/v1; Max-Age=604800.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
