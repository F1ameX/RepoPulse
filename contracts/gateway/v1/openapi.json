              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "repopulse_guest: HttpOnly; Secure; SameSite=Lax; Path=/api/v1; без Max-Age/Expires; серверный срок 24 ч.",
