          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "200": {
            "description": "Повтор при действующем guest: тот же контекст и первоначальный срок без продления.",
