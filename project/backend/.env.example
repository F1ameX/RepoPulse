# The application reads process environment variables, not this file.
# All services:
LOG_LEVEL=info
# API and Auth:
SHUTDOWN_TIMEOUT=10s

# API only:
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Auth only:
AUTH_GRPC_ADDR=127.0.0.1:9090
# Required. Contains a password: do not commit real values.
AUTH_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/repopulse?sslmode=disable
