# The application reads process environment variables, not this file.
# All services:
LOG_LEVEL=info
# API and Auth:
SHUTDOWN_TIMEOUT=10s

# API only:
HTTP_ADDR=127.0.0.1:8080
AUTH_GRPC_TARGET=127.0.0.1:9090
AUTH_REQUEST_TIMEOUT=3s
PUBLIC_ORIGIN=http://localhost:3000
# false only for local HTTP. Use true with HTTPS:
COOKIE_SECURE=true
GITHUB_CHECK_TIMEOUT=25s
GITHUB_TOKEN=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=60s

# API: actual deployed rule/profile versions, examples match contract fixtures.
ANALYZER_VERSIONS={"schema":"mvp-contract-1.1.0","methodology":"rhs-mvp-1.1.0","scoring_config":"rhs-mvp-1.1.0","collector_profile":"github-mvp-1.1.0","secret_rules":"secrets-mvp-1.0.0","recommendation_catalog":"recommendations-mvp-1.0.0","explanation_schema":"catalog-selection-1.0.0","prompt":"catalog-selection-1.0.0"}

# Auth only:
AUTH_GRPC_ADDR=127.0.0.1:9090

# Required. :Contains a password: do not commit real values.
AUTH_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/repopulse?sslmode=disable

# API and Analyzer; apply migrations before starting outside Compose.
# Docker Compose applies them through the migrations container:
ANALYZER_DATABASE_URL=postgres://repopulse:local-password@127.0.0.1:5432/repopulse?sslmode=disable
ANALYZER_DATABASE_TIMEOUT=5s
