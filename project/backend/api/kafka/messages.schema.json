          "type": "object",
          "properties": {
            "user_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "user_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "guest_session_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "guest_session_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AnalysisWindow": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "until": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        }
      },
      "required": [
        "from",
        "until"
      ],
      "additionalProperties": false
    },
