{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repopulse:kafka:messages:v1",
  "title": "RepoPulse MVP Kafka messages",
  "description": "Kafka key = analysis_id. Окно from < until проверяется обработчиком. Полные результаты и credentials не передаются.",
