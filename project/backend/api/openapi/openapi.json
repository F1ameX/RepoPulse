{
  "openapi": "3.1.1",
  "info": {
    "title": "RepoPulse MVP HTTP API",
    "version": "1.0.0",
    "description": "HTTP/JSON через API Service. Права гостей и пользователей различаются. JSON использует snake_case и строковые статусы; API выполняет явное преобразование protobuf, а не прямую сериализацию ProtoJSON."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Проверка процесса API",
        "security": [],
        "responses": {
          "200": {
            "description": "API работает",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/guest-session": {
      "post": {
        "operationId": "createGuestSession",
        "summary": "Создать гостевую сессию",
        "security": [],
        "responses": {
          "201": {
            "description": "Создана гостевая сессия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "repopulse_guest=<JWT>; HttpOnly; Secure; SameSite=Lax; Path=/api/v1. Срок cookie совпадает с expires_at.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Проверка Origin не пройдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Зависимый сервис недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "JWT не возвращается в JSON. Существующий гостевой отчёт не переносится в аккаунт."
      }
    },
