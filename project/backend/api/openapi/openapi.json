    "/api/v1/reports/{report_id}/pdf": {
      "get": {
        "operationId": "getReportPdf",
        "summary": "Скачать свой отчёт в PDF",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "PDF пользовательского отчёта",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename=\"repopulse-report-R123.pdf\""
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credentials недействительны или требуется вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс отсутствует или принадлежит другому владельцу",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Зависимый сервис недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "description": "Для гостя 401 с code=login_required. Для чужого или гостевого отчёта после входа — 404. PDF создаётся из сохранённого отчёта без нового анализа."
      }
    },
    "/api/v1/reports": {
      "get": {
        "operationId": "getUserReports",
        "summary": "История собственных пользовательских отчётов",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список отчётов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credentials недействительны или требуется вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Зависимый сервис недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "repository",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$",
              "description": "Необязательный фильтр owner/name"
            }
          }
        ],
        "description": "Гость получает 401 с code=login_required. Сортировка generated_at DESC, затем report_id DESC."
      }
    },
