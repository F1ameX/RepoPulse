          "503": {
            "description": "Зависимый сервис недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "description": "Только пользовательские отчёты текущего владельца. Сортировка generated_at DESC, затем report_id DESC."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "GuestCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "repopulse_guest"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "login",
          "password"
        ],
        "additionalProperties": false
      },
      "RegisteredUser": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "user_id"
        ],
        "additionalProperties": false
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1
          },
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "refresh_token"
        ],
        "additionalProperties": false
      },
      "GuestSession": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expires_at"
        ],
        "additionalProperties": false
      },
      "StartAnalysisRequest": {
        "type": "object",
        "properties": {
          "repository_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/?$"
          }
        },
        "required": [
          "repository_url"
        ],
        "additionalProperties": false
      },
      "AnalysisCreated": {
        "type": "object",
        "properties": {
          "status": {
            "const": "created"
          },
          "analysis_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "analysis_id"
        ],
        "additionalProperties": false
      },
      "ExistingReport": {
        "type": "object",
        "properties": {
          "status": {
            "const": "report_exists"
          },
          "report_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "report_id"
        ],
        "additionalProperties": false
      },
      "AnalysisError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "StageState": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "PREPARING",
              "COLLECTING",
              "ANALYZING",
              "SCORING",
              "RECOMMENDING",
              "REPORTING"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "progress_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Только подтверждённый прогресс этапа; поле отсутствует, если процент неизвестен."
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      },
      "AnalysisStatus": {
        "type": "object",
        "properties": {
          "analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "current_stage": {
            "enum": [
              "PREPARING",
              "COLLECTING",
              "ANALYZING",
              "SCORING",
              "RECOMMENDING",
              "REPORTING"
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageState"
            }
          },
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "$ref": "#/components/schemas/AnalysisError"
          }
        },
        "required": [
          "analysis_id",
          "status",
          "stages"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": [
                "report_id"
              ],
              "not": {
                "required": [
                  "error"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "required": [
                "error"
              ],
              "not": {
                "required": [
                  "report_id"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "queued",
                    "running"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "report_id"
                    ]
                  },
                  {
                    "required": [
                      "error"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "running"
                }
              }
            },
            "then": {
              "required": [
                "current_stage"
              ]
            }
          }
        ]
      },
      "AnalysisWindow": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "from",
          "until"
        ],
        "additionalProperties": false
      },
      "RepositoryRef": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "owner",
          "name"
        ],
        "additionalProperties": false
      },
      "Repository": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "canonical_url": {
            "type": "string",
            "format": "uri"
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "pushed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "owner",
          "name",
          "canonical_url",
          "default_branch"
        ],
        "additionalProperties": false
      },
      "SourceCollectionState": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "github",
              "sandbox",
              "sonarqube"
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "not_applicable"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "section",
          "status",
          "reason_codes"
        ],
        "additionalProperties": false
      },
      "Completeness": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SourceCollectionState"
            }
          }
        },
        "required": [
          "sections"
        ],
        "additionalProperties": false
      },
      "CategoryScore": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "explanation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "not_applicable"
            ]
          }
        },
        "required": [
          "category",
          "score",
          "explanation",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        ]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "source": {
            "enum": [
              "github",
              "sandbox",
              "sonarqube"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "source",
          "message"
        ],
        "additionalProperties": false
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1
          },
          "complexity": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "related_finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "priority",
          "action",
          "expected_effect",
          "complexity",
          "related_finding_ids"
        ],
        "additionalProperties": false
      },
      "Report": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "repository_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "repository_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "analysis_window": {
            "$ref": "#/components/schemas/AnalysisWindow"
          },
          "collector_profile_version": {
            "type": "string",
            "minLength": 1
          },
          "overall_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "category_scores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryScore"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            }
          },
          "completeness": {
            "$ref": "#/components/schemas/Completeness"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "report_id",
          "analysis_id",
          "repository",
          "repository_updated_at",
          "repository_revision",
          "analysis_window",
          "collector_profile_version",
          "overall_score",
          "category_scores",
          "findings",
          "recommendations",
          "completeness",
          "generated_at",
          "schema_version"
        ],
        "additionalProperties": false
      },
      "ReportSummary": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryRef"
          },
          "overall_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "report_id",
          "analysis_id",
          "repository",
          "overall_score",
          "generated_at"
        ],
        "additionalProperties": false
      },
      "ReportList": {
        "type": "object",
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            }
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "reports",
          "total_count",
          "limit",
          "offset"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
