{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:repopulse:llm:scoring:v1",
  "title": "Scoring LLM output",
  "properties": {
    "overall_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "category_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "explanation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "not_applicable"
            ]
          }
        },
        "required": [
          "category",
          "score",
          "explanation",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        ]
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "overall_score",
    "category_scores",
    "explanation"
  ]
}
